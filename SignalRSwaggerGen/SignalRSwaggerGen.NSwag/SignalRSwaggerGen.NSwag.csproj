<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;netstandard2.1</TargetFrameworks>
		<SignAssembly>True</SignAssembly>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<Authors>Dorin Mocan</Authors>
		<Company>Essencebit</Company>
		<Description>This package can be used to generate Swagger documentation for SignalR hubs.</Description>
		<PackageTags>nswag swagger openapi open api swashbuckle swaggergen documentation description signalr hub websocket wss rest api web socket http doc generation extension handler handle intercept plugin auto standard net core microsoft web socket schema ui gen extension display tag ui interface security presentation essencebit moldova</PackageTags>
		<PackageProjectUrl>https://github.com/essencebit/SignalRSwaggerGen/wiki</PackageProjectUrl>
		<RepositoryUrl>https://github.com/essencebit/SignalRSwaggerGen</RepositoryUrl>
		<Version>1.0.1</Version>
		<PackageReleaseNotes>Removed unnecessary parameter "IncludeInheritedMethods".</PackageReleaseNotes>
		<AssemblyVersion>1.0.1.0</AssemblyVersion>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<FileVersion>1.0.1.0</FileVersion>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<PackageIcon>Logo.png</PackageIcon>
		<PackageIconUrl />
		<RootNamespace>SignalRSwaggerGen.NSwag</RootNamespace>
		<AssemblyOriginatorKeyFile>C:\Users\dorin\OneDrive\Documents\Business\Essencebit\Process\Utils\.NET\Assembly signing\ssg.snk</AssemblyOriginatorKeyFile>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<DocumentationFile>C:\Projects\SignalRSwaggerGen\SignalRSwaggerGen\SignalRSwaggerGen.NSwag\SignalRSwaggerGen.NSwag.xml</DocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\LICENSE.md">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="..\..\Logo.png">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="..\.editorconfig" Link=".editorconfig" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Authorization" Version="2.1.0" />
		<PackageReference Include="NSwag.AspNetCore" Version="14.2.0" />
		<PackageReference Include="SignalRSwaggerGen.Utils" Version="1.7.0" />
		<PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
	</ItemGroup>

</Project>
